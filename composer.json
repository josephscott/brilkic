{
	"name": "josephscott/brilkic",
	"license": "MIT",
	"authors": [
		{
			"name": "Joseph Scott",
			"email": "joseph@josephscott.org"
		}
	],
	"require": {
		"php": ">=8.4",
		"nikic/fast-route": "1.3.0",
		"laminas/laminas-escaper": "2.18.0"
	},
	"require-dev": {
		"phpstan/phpstan": "2.2.0",
		"pestphp/pest": "4.7.0",
		"friendsofphp/php-cs-fixer": "3.95.2",
		"josephscott/phpcsfixer-config": "0.0.7"
	},
	"config": {
		"allow-plugins": false,
		"optimize-autoloader": true,
		"classmap-authoritative": true,
		"apcu-autoloader": true,
		"sort-packages": true
	}
}
