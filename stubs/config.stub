<?php
declare(strict_types = 1);

final class Config {
	const string ROUTE_PATH = '';
	const string TEMPLATE_PATH = '';
	const string CHAR_SET = 'utf-8';

	// Sent (with charset appended) before dispatch; routes may override via
	// header(). Set to '' to send no default Content-Type.
	const string DEFAULT_CONTENT_TYPE = 'text/html';

	// Optional CSRF settings. Both default to 'csrf_token' when omitted, so
	// these only need defining to override the names. CSRF_TOKEN_FIELD is the
	// hidden form field / $_POST key; CSRF_SESSION_KEY is the $_SESSION key the
	// token is stored under.
	const string CSRF_TOKEN_FIELD = 'csrf_token';
	const string CSRF_SESSION_KEY = 'csrf_token';

	// Optional `const int CSRF_TOKEN_TTL` (intentionally not declared here):
	// seconds a minted CSRF token stays valid before it expires. Defaults to
	// 1800 (30 minutes) when omitted; csrf_token()/csrf_field() also take a
	// per-call $ttl that overrides it. Read by name (csrf_token_ttl()) so it
	// stays optional.

	// Optional `const bool SESSION_AUTO_RESUME` (intentionally not declared
	// here): run_app() resumes an existing session when the client presents its
	// cookie, so a continued session's data is available before routes run.
	// On by default; define it as false to turn the auto-resume off. Read by
	// name (session_auto_resume()) so it stays optional.
}
