<?php
declare(strict_types = 1);

final class Config {
	const string ROUTE_PATH = '';
	const string TEMPLATE_PATH = '';
	const string CHAR_SET = 'utf-8';

	// Sent (with charset appended) before dispatch; routes may override via
	// header(). Set to '' to send no default Content-Type.
	const string DEFAULT_CONTENT_TYPE = 'text/html';

	// Optional CSRF settings. Both default to 'csrf_token' when omitted, so
	// these only need defining to override the names. CSRF_TOKEN_FIELD is the
	// hidden form field / $_POST key; CSRF_SESSION_KEY is the $_SESSION key the
	// token is stored under.
	const string CSRF_TOKEN_FIELD = 'csrf_token';
	const string CSRF_SESSION_KEY = 'csrf_token';

	// Optional `const int CSRF_TOKEN_TTL` (intentionally not declared here):
	// seconds a minted CSRF token stays valid before it expires. Defaults to
	// 1800 (30 minutes) when omitted; csrf_token()/csrf_field() also take a
	// per-call $ttl that overrides it. Read by name (csrf_token_ttl()) so it
	// stays optional.

	// Optional `const bool SESSION_AUTO_RESUME` (intentionally not declared
	// here): run_app() resumes an existing session when the client presents its
	// cookie, so a continued session's data is available before routes run.
	// On by default; define it as false to turn the auto-resume off. Read by
	// name (session_auto_resume()) so it stays optional.

	// Optional `const array SESSION_OPTIONS` (intentionally not declared here):
	// per-app session settings, passed straight to session_start(). Any session.*
	// directive works (without the prefix) -- e.g. cookie_lifetime, gc_maxlifetime,
	// cookie_path, cookie_domain, sid_length. The cookie is Secure (HTTPS-only) and
	// SameSite=Lax by default; override with `[ 'cookie_secure' => false ]` for
	// plain-HTTP local dev or `[ 'cookie_samesite' => 'None' ]` for a cross-site
	// embed. use_strict_mode (fixation protection) and HttpOnly are forced on and
	// cannot be overridden here. Read by name (session_options()) so it stays
	// optional. Note: cookie_lifetime (browser) and gc_maxlifetime (server) are
	// independent -- a persistent login wants both set.

	// Optional trailing-slash redirect (all three intentionally not declared
	// here; each is read by name so it stays optional):
	//
	//   `const bool TRAILING_SLASH_REDIRECT` -- when a path does not match,
	//   run_app() tries its trailing-slash variant and, if that is a registered
	//   route, redirects to it instead of 404. On by default; define it as
	//   false to turn the redirect off.
	//
	//   `const bool TRAILING_SLASH_ADD` -- direction. Defaults to false (strip a
	//   trailing slash, so "/csrf/" -> "/csrf"). Define it as true to reverse it
	//   (add a trailing slash, so "/csrf" -> "/csrf/").
	//
	//   `const int TRAILING_SLASH_REDIRECT_CODE` -- redirect status. Defaults to
	//   302 (temporary); set to 301 for a permanent, cacheable redirect.
}
